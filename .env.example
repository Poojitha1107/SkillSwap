# Server Port
PORT=5000

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string
MONGO_URI=your_actual_mongodb_connection_string


# Session Secret (change this to a secure random string)
SESSION_SECRET=your_actual_session_secret

# Seed Admin Credentials (used by: npm run seed:admin)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password

